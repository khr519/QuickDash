{
    "disks" : [
        {
            "name" : "SSD",
            "path" : "/"
        },
        {
            "name" : "HDD",
            "path" : "/data"
        }
    ],
    "tabs" : {
        /*
        "Minecraft" : {
            "container" : "minecraft-mc-1", // If using docker, specify the container name here.

            "command" : { // This is a Label that shows a custom command output.
                "exec" : "rcon-cli list", // This will execute "docker exec minecraft-mc-1 rcon-cli list" (since the container is specified)
                "parse" : "f'online: {output.split(' ')[2]}/{output.split(' ')[7]}'" // python code snippet which will be evaluated using eval(). the {output} variable contains the command output.
            },

            "log" : { // This is the log viewer configuration. (since the docker container is specified, no log command is needed. (although, you can use a different command even when using docker.))
                "ignore" : ["RCON"], // List of strings to ignore. (in this case, any lines containing "RCON" will be ignored)
                "parse" : "f'from minecraft: {line}'" // python code snippet which will be evaluated using eval(). the {line} variable contains the log line.
            }
        },

        "Caddy" : {
            "log" : {
                "command" : "docker logs -f caddy", // this time, no container specified. So the full command is needed.
                "parse" : "json.loads(line)['msg']"
            }
        },
        */

        "Empty example" : {
            // No container or log command specified. This will show an error message in the log viewer.
        },

        "Just a Command" : { // A tab with just a command output (log viewer will show an error message)
            "command" : {
                "exec" : "date",
                "parse" : "f'The current date and time is: {output}'"
            }
        },

        "SysLog" : { // A tab with just a log viewer (command will tail the syslog)
            "log" : {
                "command" : "tail -f /var/log/README",
                "ignore" : ["CRON"]
            }
        }
    }
}