{
    "disks" : [
        {
            "name" : "SSD",
            "path" : "/"
        },
        {
            "name" : "HDD",
            "path" : "/data"
        }
    ],
    "custom" : {
        "Minecraft" : {
            "container" : "minecraft-mc-1",

            "command" : {
                "exec" : "rcon-cli list",
                "parse" : "'online: '+output.split(' ')[2]+'/'+output.split(' ')[7]"
            },

            "log" : {
                "ignore" : ["RCON"]
            }
        },

        "Caddy" : {
            "container" : "caddy",

            "log" : {
                "parse" : "json.loads(line)['msg']"
            }
        },

        "Obsidian LiveSync" : {
            "container" : "couchdb-ols"
        },

        "Nextcloud" : {
            "container" : "actually this isnt needed here",

            "log" : {
                "command" : "docker exec nextcloud-aio-nextcloud tail data/nextcloud.log",
                "parse" : "json.loads(line)['message']"
            }

        }
    }
}